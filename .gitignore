# Local-only credential scratch (Slack bot token, channel id). Never committed.
.env

# Local git worktrees used by parallel lanes.
.worktrees/

# Verification artifacts written into the working tree by the runbooks and
# by CI (`make chat | tee chat.out`, ledger/audit dumps). They are run
# output, not source — and a captured A2A task or an AKS transcript is
# exactly the kind of thing that must not land in a public repo.
*.out

# The checksum-verified kagent CLI download lands in the repo-root bin/.
#
# Anchored with a leading slash on purpose: an unanchored `bin/` matches at
# EVERY depth, which silently swallowed cli/bin/kaimahi.js — the CLI's own
# entry point — so the committed package.json pointed at a file that was not
# in the repository. `git add -A` skips ignored paths without a word. Keep
# this anchored, and prefer anchored rules for build-output directories
# whose names are common.
/bin/
