.env
bin/
.worktrees/
# Local-only credential scratch (Slack bot token, channel id). Never committed.
.env

# Verification artifacts written into the working tree by the runbooks and
# by CI (`make chat | tee chat.out`, ledger/audit dumps). They are run
# output, not source — and a captured A2A task or an AKS transcript is
# exactly the kind of thing that must not land in a public repo.
*.out

# Python bytecode caches: two .pyc files once landed on main because this
# rule was missing.
__pycache__/
*.pyc

# `make backup` output: a pg_dump of the plane's database (credential
# hashes, the ledger, audit trails). Operator data, never source.
backups/

# CI's synthetic hosted upstream (scripts/ci/synthetic-upstream.sh): a
# throwaway CA, its key and certificate, and the patched table. Job-local.
.synthetic-upstream/
