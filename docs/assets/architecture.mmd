%%{init: {"theme": "base", "flowchart": {"htmlLabels": true, "nodeSpacing": 30, "rankSpacing": 42, "curve": "linear"}, "themeVariables": {"background": "#071521", "fontFamily": "Arial, Helvetica, sans-serif", "fontSize": "20px", "textColor": "#F7F4E8", "titleColor": "#F7F4E8", "primaryColor": "#F7F4E8", "primaryTextColor": "#071521", "primaryBorderColor": "#24D6D9", "lineColor": "#24D6D9", "edgeLabelBackground": "#071521", "clusterBkg": "#0D2947", "clusterBorder": "#24D6D9", "tertiaryColor": "#0D2947"}}}%%
flowchart TB
    A["Kubernetes-hosted agent"]

    subgraph K["Kaimahi governance plane"]
      direction TB
      P["Bounded approvals<br/>expiry and/or use count"]
      L["LLM proxy<br/>auth · budgets<br/>credential custody · spend ledger"]
      T["MCP gateway<br/>tool allowlists<br/>upstream bounds · audit"]
      P -. "temporary grant" .-> L
      P -. "temporary grant" .-> T
    end

    M["Model provider"]
    X["MCP tool server"]

    A -->|"governed model call"| L
    A -->|"governed tool call"| T
    L -->|"model relay"| M
    T -->|"tool relay"| X
    A -. "plain model preset · ungoverned" .-> M
    A -. "direct MCP wiring · ungoverned" .-> X

    classDef agent fill:#F7F4E8,color:#071521,stroke:#24D6D9,stroke-width:3px;
    classDef control fill:#F7F4E8,color:#071521,stroke:#60A5FA,stroke-width:3px;
    classDef approval fill:#FFF1B3,color:#071521,stroke:#FFB547,stroke-width:3px;
    classDef target fill:#F7F4E8,color:#071521,stroke:#60A5FA,stroke-width:3px;
    class A agent;
    class L,T control;
    class P approval;
    class M,X target;
    linkStyle 0,1 stroke:#FFB547,color:#FFF1B3,stroke-width:3px,stroke-dasharray:7 5;
    linkStyle 2,3 stroke:#24D6D9,color:#F7F4E8,stroke-width:4px;
    linkStyle 4,5 stroke:#60A5FA,color:#F7F4E8,stroke-width:4px;
    linkStyle 6,7 stroke:#FFB547,color:#FFF1B3,stroke-width:3px,stroke-dasharray:9 6;
